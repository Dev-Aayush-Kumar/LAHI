# LAHI AI worker (FastAPI /v1)
#
# Copy to `ai/.env`. Never commit real secrets or model credentials.
# Process / Colab environment variables win over this file.
#
# These are GPU-worker / AI-service variables. Do not put them in the
# browser. The Next.js server reads a matching AI_SERVER_TOKEN from
# frontend/.env and never exposes it as NEXT_PUBLIC_*.

# Required to serve /v1. Must match frontend/.env AI_SERVER_TOKEN.
# Example is local-dev only. Generate a long random value for any remote worker.
AI_SERVER_TOKEN=dev-ai-token

# mock = local tests and synthetic try-on (default)
# gpu  = real Florence / SAM2 / pose / IDM-VTON. Never falls back to mock output.
AI_EXECUTION_MODE=mock

# inline = deterministic pytest
# thread = local or remote server that accepts jobs while /v1 stays up
AI_QUEUE_BACKEND=inline

# Bind address. Remote GPU workers must listen on all interfaces.
AI_HOST=0.0.0.0
AI_PORT=8000

# CORS for browsers that call /v1 directly. The storefront should not do that;
# it uses the Next.js media proxy. Use * on a temporary Colab tunnel.
AI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistent /v1 asset store. Default: ai/var/assets
AI_STORAGE_ROOT=

# Sequential T4 planning budget in MB. Not a hard CUDA allocator limit.
AI_VRAM_BUDGET_MB=15000

# Hugging Face model id. First GPU garment job may download this into HF cache.
AI_FLORENCE_MODEL=microsoft/Florence-2-base

# Optional Hugging Face cache root (Florence-2 download destination).
HF_HOME=

# IDM-VTON vendor root. Default: ai/external/IDM-VTON
# Must contain src/*.py, ckpt/{scheduler,vae,unet,...}, ckpt/densepose/,
# and preferably ckpt/openpose/ + ckpt/humanparsing/ — not in git.
AI_IDM_ROOT=
