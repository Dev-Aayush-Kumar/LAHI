# LAHI commerce application (Next.js + Prisma)
#
# Copy to `frontend/.env`. Never commit real secrets.
# All of these are server-only. There are no NEXT_PUBLIC_ AI variables.
# AI_SERVER_TOKEN must never be sent to the browser.

# ---------------------------------------------------------------------------
# Database / auth (server-only)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lahi
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# AI worker (server-only — Next.js API routes and the /api/vto/media proxy)
# ---------------------------------------------------------------------------
# Local mock AI: http://127.0.0.1:8000
# Remote GPU / Colab tunnel: https://<TUNNEL_URL>  (no trailing slash)
AI_SERVER_URL=http://127.0.0.1:8000
# Must match ai/.env AI_SERVER_TOKEN. Never prefix with NEXT_PUBLIC_.
AI_SERVER_TOKEN=dev-ai-token

# ---------------------------------------------------------------------------
# Payments / storage (server-only)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=
STORAGE_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Optional seed / admin / media tools (server-only)
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
SEED_RESET_CATALOG=
FFMPEG_PATH=
